{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Train Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/train.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Run Streamlit App",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app/main.py"],
      "console": "integratedTerminal"
    }
  ]
}
